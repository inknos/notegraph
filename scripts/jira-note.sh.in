#!/usr/bin/env bash
set -euo pipefail

DEFAULT_DIR="$HOME/Documents/Logseq/Work/pages"
JIRA_REPO="${JIRA_REPO:-$HOME/Documents/personal_projects/notegraph/jira}"
JIRA_ENDPOINT="${JIRA_ENDPOINT:-{{JIRA_ENDPOINT}}}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

file_sep="___"
wikilink_sep="/"

usage() {
  echo "Usage: jira-note.sh [--check] [-d <dir>] <ISSUE-KEY>"
  echo "  -d <dir>   Target directory (default: $DEFAULT_DIR)"
  echo "  --check    Print JSON with file paths and existence status, then exit"
  echo "  e.g. jira-note.sh RUN-3555"
  echo "  e.g. jira-note.sh --check RUN-3555"
  exit 1
}

# Strips browse URL prefix and uppercases the key
normalize_issue_key() {
  local raw="$1"
  if [[ "$raw" =~ ^https://[^/]+/browse/([A-Z]+-[0-9]+) ]]; then
    raw="${BASH_REMATCH[1]}"
  fi
  echo "$raw" | tr '[:lower:]' '[:upper:]'
}

# ---------------------------------------------------------------------------
# Path computation functions
# Require: dest_dir, JIRA_ENDPOINT, file_sep, wikilink_sep
# ---------------------------------------------------------------------------
file_prefix_for() {
  echo "${dest_dir}/${JIRA_ENDPOINT}${file_sep}${1}"
}

wikilink_for() {
  echo "${JIRA_ENDPOINT}${wikilink_sep}${1}"
}

md_path_for()     { echo "$(file_prefix_for "$1").md"; }
note_path_for()   { echo "$(file_prefix_for "$1")${file_sep}note.md"; }
cursor_path_for() { echo "$(file_prefix_for "$1")${file_sep}cursor.yaml"; }

# ---------------------------------------------------------------------------
# go-jira helper
# ---------------------------------------------------------------------------
jira_cmd() {
  (cd "$JIRA_REPO" && go run -tags gnome_keyring cmd/jira/main.go "$@" 2>/dev/null)
}

# ---------------------------------------------------------------------------
# File-write helpers
# ---------------------------------------------------------------------------
write_if_missing() {
  local path="$1"
  local content="$2"
  if [[ -f "$path" ]]; then
    echo "  skip (exists): $path"
  else
    printf '%s\n' "$content" > "$path"
    echo "  created:       $path"
  fi
}

write_always() {
  local path="$1"
  local content="$2"
  printf '%s\n' "$content" > "$path"
  if [[ -f "$path" ]]; then
    echo "  updated:       $path"
  else
    echo "  created:       $path"
  fi
}

# ---------------------------------------------------------------------------
# Build comments section from issue JSON
# ---------------------------------------------------------------------------
build_comments() {
  local json="$1"
  local count
  count=$(echo "$json" | jq '.comment.comments | length')
  if [[ "$count" -gt 0 ]]; then
    echo "$json" | jq -r '
      .comment.comments[] |
      "### \(.author.displayName) (\(.created[:10]))\n\n\(.body)\n"
    '
  fi
}

# ---------------------------------------------------------------------------
# Create files for a single issue
#   $1 = key, $2 = "full" or "md-only", $3 = fields JSON
# ---------------------------------------------------------------------------
create_issue_files() {
  local key="$1"
  local mode="$2"
  local json="$3"

  local s_summary s_status s_assignee s_description s_created s_jira_url s_wikilink s_gh_pr
  s_summary=$(echo "$json" | jq -r '.summary // ""')
  s_status=$(echo "$json" | jq -r '.status.name')
  s_assignee=$(echo "$json" | jq -r '.assignee.displayName // "Unassigned"')
  s_description=$(echo "$json" | jq -r '.description // ""')
  s_created=$(echo "$json" | jq -r '.created[:10]')
  # customfield_10875 may be a bare URL or Jira wiki markup like [url|url|smart-link]
  s_gh_pr=$(echo "$json" | jq -r '.customfield_10875 // empty' | sed 's/^\[//;s/|.*//;s/\].*//;s/[[:space:]]//g')
  s_jira_url="https://${JIRA_ENDPOINT}/browse/${key}"
  s_wikilink=$(wikilink_for "$key")

  local comments_section
  comments_section=$(build_comments "$json")

  local gh_link_section=""
  if [[ -n "$s_gh_pr" ]]; then
    if [[ "$s_gh_pr" =~ github\.com/([^/]+)/([^/]+)/(pull|issues)/([0-9]+) ]]; then
      local gh_wikilink="github.com/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}/${BASH_REMATCH[4]}"
      gh_link_section="
## GitHub PR

[${s_gh_pr}](${s_gh_pr})
[[${gh_wikilink}]]"
    fi
  fi

  local footer=""
  if [[ "$mode" == "full" ]]; then
    footer="
---

[[${s_wikilink}${wikilink_sep}note]]
[[${s_wikilink}${wikilink_sep}cursor]]"
  fi

  local md_content="# ${s_summary}

${s_jira_url}

**Status:** ${s_status} | **Assignee:** ${s_assignee} | **Created:** ${s_created}

## Description

${s_description}

## Comments

${comments_section}${gh_link_section}${footer}"

  local md_path
  md_path=$(md_path_for "$key")
  write_always "$md_path" "$md_content"

  if [[ "$mode" == "full" ]]; then
    local note_path cursor_path
    note_path=$(note_path_for "$key")
    cursor_path=$(cursor_path_for "$key")

    local note_content="# ${s_summary}

## Notes

## TODOs

## Related

---

[[${s_wikilink}${wikilink_sep}cursor]]
[[${s_wikilink}]]"

    local cursor_content
    cursor_content="title: \"${s_summary}\"
url: \"${s_jira_url}\"
type: $(echo "$json" | jq -r '.issuetype.name | ascii_downcase')
status: $(echo "$s_status" | tr '[:upper:]' '[:lower:]')
assignee: \"${s_assignee}\"
created: \"${s_created}\""

    write_if_missing "$note_path" "$note_content"
    write_if_missing "$cursor_path" "$cursor_content"
  fi

  if [[ -n "$s_gh_pr" ]]; then
    if [[ "$mode" == "full" ]]; then
      echo "  -> gh-note.sh ${s_gh_pr}"
      "$SCRIPT_DIR/gh-note.sh" -d "$dest_dir" "$s_gh_pr" || true
    else
      echo "  -> gh-note.sh --md-only ${s_gh_pr}"
      "$SCRIPT_DIR/gh-note.sh" -d "$dest_dir" --md-only "$s_gh_pr" || true
    fi
  fi
}

main() {
  local dest_dir="$DEFAULT_DIR"
  local check_only=false

  local args=()
  for arg in "$@"; do
    case "$arg" in
      --check) check_only=true ;;
      *)       args+=("$arg") ;;
    esac
  done
  set -- "${args[@]}"

  OPTIND=1
  while getopts ":d:" opt; do
    case $opt in
      d) dest_dir="$OPTARG" ;;
      *) usage ;;
    esac
  done
  shift $((OPTIND - 1))

  [[ $# -ne 1 ]] && usage

  local issue_key
  issue_key=$(normalize_issue_key "$1")

  # ------------------------------------------------------------------
  # --check: return JSON with paths and existence, no network calls
  # ------------------------------------------------------------------
  if [[ "$check_only" == true ]]; then
    exists() { [[ -f "$1" ]] && echo true || echo false; }
    local md_p note_p cursor_p
    md_p=$(md_path_for "$issue_key")
    note_p=$(note_path_for "$issue_key")
    cursor_p=$(cursor_path_for "$issue_key")
    printf '{"md":{"path":"%s","exists":%s},"note":{"path":"%s","exists":%s},"cursor":{"path":"%s","exists":%s}}\n' \
      "$md_p" "$(exists "$md_p")" \
      "$note_p" "$(exists "$note_p")" \
      "$cursor_p" "$(exists "$cursor_p")"
    exit 0
  fi

  # ------------------------------------------------------------------
  # Fetch issue data
  # ------------------------------------------------------------------
  echo "Fetching $issue_key ..."
  local fields_json
  fields_json=$(jira_cmd view "$issue_key" --gjq 'fields')

  local issue_type status summary assignee description created jira_url
  issue_type=$(echo "$fields_json" | jq -r '.issuetype.name')
  status=$(echo "$fields_json" | jq -r '.status.name')
  summary=$(echo "$fields_json" | jq -r '.summary // ""')
  assignee=$(echo "$fields_json" | jq -r '.assignee.displayName // "Unassigned"')
  description=$(echo "$fields_json" | jq -r '.description // ""')
  created=$(echo "$fields_json" | jq -r '.created[:10]')

  jira_url="https://${JIRA_ENDPOINT}/browse/${issue_key}"

  mkdir -p "$dest_dir"

  # ------------------------------------------------------------------
  # Non-epic: single issue
  # ------------------------------------------------------------------
  if [[ "$issue_type" != "Epic" ]]; then
    if [[ "$status" == "Closed" ]]; then
      echo "Issue $issue_key is Closed, skipping."
      exit 0
    fi
    echo "Creating files for $issue_key ($issue_type, $status) ..."
    create_issue_files "$issue_key" "full" "$fields_json"
    echo "Done."
    exit 0
  fi

  # ------------------------------------------------------------------
  # Epic: query all children
  # ------------------------------------------------------------------
  echo "Epic detected. Querying children of $issue_key ..."

  local children_raw
  children_raw=$(jira_cmd list --query "parent = ${issue_key} ORDER BY created ASC" 2>/dev/null || true)

  if [[ -z "$children_raw" ]]; then
    echo "No children found for $issue_key, skipping."
    exit 0
  fi

  local child_keys=()
  while IFS= read -r line; do
    local key
    key=$(echo "$line" | sed 's/:.*//' | tr -d '[:space:]')
    [[ -n "$key" ]] && child_keys+=("$key")
  done <<< "$children_raw"

  if [[ ${#child_keys[@]} -eq 0 ]]; then
    echo "No children found for $issue_key, skipping."
    exit 0
  fi

  echo "Found ${#child_keys[@]} children: ${child_keys[*]}"

  declare -A child_json_map
  declare -A child_status_map
  local has_open=false

  local ckey
  for ckey in "${child_keys[@]}"; do
    echo "  Fetching $ckey ..."
    local cjson cstatus
    cjson=$(jira_cmd view "$ckey" --gjq 'fields')
    child_json_map["$ckey"]="$cjson"
    cstatus=$(echo "$cjson" | jq -r '.status.name')
    child_status_map["$ckey"]="$cstatus"
    if [[ "$cstatus" != "Closed" ]]; then
      has_open=true
    fi
  done

  if [[ "$has_open" == false ]]; then
    echo "All children of $issue_key are Closed, skipping."
    exit 0
  fi

  # ------------------------------------------------------------------
  # Create epic md (always regenerated)
  # ------------------------------------------------------------------
  echo "Creating epic page for $issue_key ..."

  local children_list=""
  for ckey in "${child_keys[@]}"; do
    local cstatus="${child_status_map[$ckey]}"
    local csummary
    csummary=$(echo "${child_json_map[$ckey]}" | jq -r '.summary // ""')
    local cwikilink
    cwikilink=$(wikilink_for "$ckey")
    if [[ "$cstatus" == "Closed" ]]; then
      children_list="${children_list}
- ~~[[${cwikilink}]] ${csummary}~~ (${cstatus})"
    else
      children_list="${children_list}
- [[${cwikilink}]] ${csummary} (**${cstatus}**)"
    fi
  done

  local epic_md="# ${summary}

${jira_url}

**Status:** ${status} | **Assignee:** ${assignee} | **Created:** ${created}

## Description

${description}

## Children
${children_list}"

  local epic_md_path
  epic_md_path=$(md_path_for "$issue_key")
  write_always "$epic_md_path" "$epic_md"

  # ------------------------------------------------------------------
  # Create files for each child
  # ------------------------------------------------------------------
  for ckey in "${child_keys[@]}"; do
    local cstatus="${child_status_map[$ckey]}"
    local cjson="${child_json_map[$ckey]}"

    if [[ "$cstatus" == "Closed" ]]; then
      echo "Creating md-only for $ckey (Closed) ..."
      create_issue_files "$ckey" "md-only" "$cjson"
    else
      echo "Creating full files for $ckey ($cstatus) ..."
      create_issue_files "$ckey" "full" "$cjson"
    fi
  done

  echo "Done."
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
